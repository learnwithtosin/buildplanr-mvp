PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/buildplanr
CORS_ORIGIN=http://localhost:3000

NODE_ENV=development

OPENAI_API_KEY=your_openai_api_key

OPENAI_MODEL=gpt-5.5

# Frontend (apps/web)
# Base URL the frontend uses to reach the backend API (see docs/API.md).
# Must be prefixed with NEXT_PUBLIC_ to be readable in the browser.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# TEMPORARY: when "true", src/lib/api.ts returns a mock response for
# POST /api/questionnaire instead of calling the backend. Set to "false"
# (or delete this var) once that endpoint is deployed and working end to end.
# See the removal steps in the comment block at the top of src/lib/api.ts.
NEXT_PUBLIC_USE_MOCK_API=true